rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && userProfile().active == true; }
    function sameCompany(companyId) { return activeUser() && userProfile().companyId == companyId; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Los perfiles deben crearse/editarse desde consola segura o backend administrativo.
      allow write: if false;
    }
    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow write: if false;
    }
    // Las demás colecciones operativas se deben habilitar por rol y companyId
    // antes de poner el sistema en producción. Por defecto, quedan cerradas.
    match /{document=**} { allow read, write: if false; }
  }
}
